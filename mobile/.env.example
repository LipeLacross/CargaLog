# ========================================
# 🚀 APLICAÇÃO MOBILE - CargaLog
# ========================================

# ========================================
# 🌐 API BACKEND
# ========================================
# URL da API do backend
# Android Emulator: use 10.0.2.2 para acessar o host
# iOS Simulator: use localhost ou 127.0.0.1
# Dispositivo físico: use o IP da máquina local (ex: 192.168.x.x)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# ========================================
# 📊 AMBIENTE
# ========================================
# Ambiente da aplicação: development, staging, production
EXPO_PUBLIC_ENV=development

# ========================================
# 🎯 FUNCIONALIDADES
# ========================================
# Ativar/desativar logs detalhados em desenvolvimento
DEBUG=true

