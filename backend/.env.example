# ========================================
# 🚀 CONFIGURAÇÃO DA APLICAÇÃO
# ========================================
# Ambiente: development, test, production
NODE_ENV=development
# Porta do servidor
PORT=3000
# CORS aberto para desenvolvimento - em produção use domínios específicos
CORS_ORIGIN=*

# ========================================
# 🗄️ BANCO DE DADOS (Supabase)
# ========================================
# Formato: postgresql://usuario:SENHA@host:porta/database?pgbouncer=true
# Usa pooler (porta 6543) - mais rápido para operações normais
DATABASE_URL="postgresql://postgres.seu-project-ref:sua-senha@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Mesma string, mas sem pooler (porta 5432) - OBRIGATÓRIO para migrations
# Usa conexão direta ao banco
DIRECT_URL="postgresql://postgres.seu-project-ref:sua-senha@db.seu-project-ref.supabase.co:5432/postgres"

# ========================================
# 🔐 AUTENTICAÇÃO JWT
# ========================================
# Secret para assinar tokens JWT (mínimo 32 caracteres)
# Em produção, gere uma string aleatória segura com openssl
JWT_SECRET=gere_uma_chave_aleatoria_com_minimo_32_caracteres_para_producao
# Tempo de expiração do token (ex: 7d, 24h, 1h)
JWT_EXPIRATION=7d

# ========================================
# 🔐 RESET DE SENHA
# ========================================
# Tempo de expiração do token de reset (ex: 1h, 30m)
RESET_PASSWORD_TOKEN_EXPIRATION=1h
# URL do frontend para o link de reset de senha
FRONTEND_URL=http://localhost:5173

# ========================================
# 📧 EMAIL (SMTP)
# ========================================
# Configuração SMTP para envio de emails
# Recomendado usar Gmail com App Password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Seu email Google
MAIL_USER=seu-email@gmail.com
# Senha de app do Google (não a senha da conta)
MAIL_PASSWORD=sua_app_password_aqui
# Email remetente
MAIL_FROM=seu-email@gmail.com

# ========================================
# 🔐 CRIPTOGRAFIA DE SENHAS (Bcrypt)
# ========================================
# Número de rounds para bcrypt (10-12 é ideal)
# Quanto maior, mais seguro mas mais lento
BCRYPT_SALT_ROUNDS=10

# ========================================
# 📊 LOGGING
# ========================================
# Nível de log: debug, info, warn, error
# Use 'debug' em desenvolvimento e 'info' em produção
LOG_LEVEL=debug
