# ========================================
# CONFIGURACAO DA APLICACAO
# ========================================
# Padrao para desenvolvimento local
NODE_ENV=development
# Porta padrao da API
PORT=3000
# CORS aberto para desenvolvimento
CORS_ORIGIN=*

# ========================================
# BANCO DE DADOS (Supabase)
# ========================================
# Substitua com sua senha/credenciais reais do Supabase
# Formato: postgresql://usuario:SENHA@host:porta/database?pgbouncer=true
# Pooler (6543) - melhor para operacoes normais
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Substitua com as credenciais de conexao direta (usada por migrations)
# Conexao direta (5432) - obrigatoria para migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ========================================
# AUTENTICACAO JWT
# ========================================
# Deve ter pelo menos 32 caracteres
JWT_SECRET=change_this_to_a_strong_secret_with_32_plus_chars
# Expiracao do token
JWT_EXPIRATION=7d

# ========================================
# RESET DE SENHA
# ========================================
# Expiracao do token de reset de senha
RESET_PASSWORD_TOKEN_EXPIRATION=1h
# URL base do frontend para reset
FRONTEND_URL=http://localhost:5173

# ========================================
# EMAIL (SMTP)
# ========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com

# ========================================
# CRIPTOGRAFIA DE SENHA (Bcrypt)
# ========================================
# 10 rounds e um bom padrao
BCRYPT_SALT_ROUNDS=10

# ========================================
# LOGS
# ========================================
# debug/info/warn/error
LOG_LEVEL=debug
